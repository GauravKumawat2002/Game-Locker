<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\GameLocker.Common\GameLocker.Common.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>GameLocker</AssemblyName>
    <RootNamespace>GameLocker.ConfigUI</RootNamespace>
    <Title>GameLocker</Title>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>..\..\installer\Icons\gamelocker.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <GameLockerGitHubUrl Condition="'$(GameLockerGitHubUrl)' == ''">https://github.com/GauravKumawat2002/Game-Locker</GameLockerGitHubUrl>
    <GameLockerWebsiteUrl Condition="'$(GameLockerWebsiteUrl)' == ''">https://gauravkumawat.dev/</GameLockerWebsiteUrl>
    <GameLockerLinkedInUrl Condition="'$(GameLockerLinkedInUrl)' == ''">https://www.linkedin.com/in/gauravkumawat2002</GameLockerLinkedInUrl>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="$(ApplicationIcon)" Link="GameLocker.ico" CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="$(ApplicationIcon)" LogicalName="GameLocker.ConfigUI.GameLocker.ico" />
    <EmbeddedResource Include="Assets\*.png" />
    <AssemblyMetadata Include="GameLockerGitHubUrl" Value="$(GameLockerGitHubUrl)" />
    <AssemblyMetadata Include="GameLockerWebsiteUrl" Value="$(GameLockerWebsiteUrl)" />
    <AssemblyMetadata Include="GameLockerLinkedInUrl" Value="$(GameLockerLinkedInUrl)" />
  </ItemGroup>

</Project>
